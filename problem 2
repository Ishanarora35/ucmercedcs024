#include "headers.h"

int count(int arr[], int x) {
    int c = 0;
    for (int i = 0; i < x; i++) {
        if (arr[i] % 2 == 0) {
            c = c +1;
        }
    }
    return c;
}

int main () {
    int array[3];
    int a,b,c;
    cin >> a;
    cin >> b;
    cin >> c;
    array[0] = a;
    array[1] = b;
    array[2] = c;
    //  size is just 3
    cout << count(array,3) << endl;
}
